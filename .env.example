# このファイルをコピーして .env.local を作成し、値を埋めてください。
#   cp .env.example .env.local
# Stripe のキーは https://dashboard.stripe.com/test/apikeys（テストモード）から取得。

# Stripe シークレットキー（サーバー専用・公開厳禁）
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Stripe 公開可能キー（ブラウザに露出してOK）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# 任意: 決済の戻り先ベースURL。
# 未設定ならリクエストの origin を自動使用するため、通常は設定不要
# （ローカル / Vercel いずれも自動で正しいURLに戻ります）。
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
