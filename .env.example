# このファイルをコピーして .env.local を作成し、値を埋めてください。
#   cp .env.example .env.local
# Stripe のキーは https://dashboard.stripe.com/test/apikeys（テストモード）から取得。

# Stripe シークレットキー（サーバー専用・公開厳禁）
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Stripe Webhook の署名の秘密 whsec_...（サーバー専用・公開厳禁）。POST /api/stripe/webhook が、Stripe から届いたことの検証に使います。
# 未設定のあいだ、この Webhook は 503 を返して何もしません（注文は成功ページ /success の確認でも確定します）。
# 取得（本番）: Stripe ダッシュボード（テストモード）→ 開発者 → Webhook → エンドポイントを追加。
#   URL は https://<本番のドメイン>/api/stripe/webhook（本番の URL だけ。プレビューやローカルは登録しない）、イベントは checkout.session.completed と
#   checkout.session.async_payment_succeeded の 2 つ。作成後に表示される「署名シークレット」を、Vercel の Production の環境変数に置きます。
# 取得（ローカル）: Stripe CLI の `stripe listen --forward-to localhost:3000/api/stripe/webhook` が表示する whsec_...
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# 任意（本番では設定を推奨）: サイトのベースURL。
# 決済の戻り先と、OGP 画像の絶対URLに使います。
# 未設定・不正な値のときは、リクエストURLの origin を使います（ローカルではそれで十分です）。
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# データベースの接続文字列（Neon。プール経由）。決済の確認 API・Webhook・GraphQL の orderBySession が注文を読み書きします。
# 本番（NODE_ENV=production。Vercel の Production と Preview を含む）では必須です。無いと注文を扱う API は例外で失敗します。
# Vercel の Preview には本番の接続文字列を入れません（プレビューのビルドが本番の利用者・注文を読み書きします）。
# Preview 用の DB（Neon のプレビューまたは開発ブランチ）を置くか、置かずに DB なしにします。
# 開発では未設定のままで構いません。そのときはリポジトリ直下の .pglite/ に保存するローカルの PGlite を使います（Neon のアカウントもネットも要りません）。
# DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 任意: マイグレーション用の直結の接続文字列（プールを通さない）。npm run db:migrate が使います。
# 未設定なら DATABASE_URL を使います。
# DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# 任意: PGlite の保存先のディレクトリ（既定は .pglite）。DATABASE_URL が無いときだけ効きます（DATABASE_URL があればそちらが先）。
# 本番ビルド（next start）をローカルで動かすときは、PGlite を使うという明示としてこれを置きます（E2E は .pglite-e2e を指定しています）。
# E2E とローカルの next start のための設定です。Vercel には置かないでください（VERCEL=1 のときは無視され、DATABASE_URL が無ければ例外になります）。
# PGLITE_DATA_DIR=.pglite

# 認証（Better Auth。メールアドレス + パスワード）のセッションの署名と暗号化の鍵（サーバー専用・公開厳禁）。
# 本番（NODE_ENV=production。Vercel の Production と Preview を含む）では必須で、32 文字以上のランダムな値にします。
# 無い・短い・開発用の固定の値だと、認証は例外で失敗します（黙って弱い鍵では動かしません）。作り方: openssl rand -base64 32
# 開発では未設定のままで構いません（開発用の固定の値を使います。本番では使えません）。Production と Preview には別の値を置きます。
# BETTER_AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 任意（本番では設定を推奨）: 認証の基準の URL（オリジンだけ。パスやクエリは付けません）。
# ログイン・登録の送信元（Origin）の検査は、この URL のオリジンを信用します。Vercel では Production にだけ本番の URL を置き、
# Preview には置きません（置くと、プレビューの URL からのログインが「信用できない送信元」として断られます）。
# 未設定のときは、リクエストの URL のオリジンを使います（ローカルではそれで十分です）。
# BETTER_AUTH_URL=http://localhost:3000
