{
  "name": "payapp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:css": "node scripts/check-flat-css.ts app components",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "next build && playwright test",
    "codegen": "graphql-codegen",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/seed-products.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@stripe/stripe-js": "^8.5.3",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.4",
    "next": "16.0.8",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "stripe": "^20.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@graphql-codegen/cli": "^7.4.5",
    "@graphql-codegen/typescript": "^6.1.1",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
